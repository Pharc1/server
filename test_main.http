Accept: application/json

### Test Health Check Endpoint
GET http://127.0.0.1:8000/health
Accept: application/json

### Generate a New Webtoon
POST http://127.0.0.1:8000/api/generate
Content-Type: application/json
Accept: application/json

{
  "prompt": "A boy named fuyuki wake up one day with a lot of muscle and an incredible face, he is a high school student and he is very popular with his new face, but before that he was victim of a bully named Lina, she was the most popular of the school at this time, When she met fuyuki with his new body she wanted to become friend with him immediatlly but she didn't know that he was the one she bullied before, she might fell in love with the guy she didn't like before that..",
  "style": "webtoon",
  "num_panels": 10,
  "characters": ["Lina", "Fuyuki"],
  "additional_context": "The story should have Two main character"
}

